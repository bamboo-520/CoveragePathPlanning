<?xml version="1.0"?>
<package format="2">
  <name>prometheus_task_allocate</name>
  <version>0.0.3</version>
  <description>MAPPO sequential task allocation with sensor-obstacle MAPPO risk, A* path planning and path command dispatch for Prometheus.</description>

  <maintainer email="amov@todo.todo">amov</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>prometheus_msgs</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>prometheus_gazebo</exec_depend>
  <exec_depend>prometheus_swarm_control</exec_depend>

  <export>
  </export>
</package>
