<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="wind_turbine_world">

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>6 -8 4 0 0.25 2.2</pose>
        <view_controller>orbit</view_controller>
