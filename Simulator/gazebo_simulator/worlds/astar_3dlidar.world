<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="astar_3dliar">

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>12.0 0.0 10.0 0 0.6 3.14</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1000.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script>
          </material>
        </visual>
      </link>
    </model>

    <model name='center_floating_block'>
      <static>true</static>
      <pose>0 0 1.5 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>3 1 1</size></box></geometry> <material><script><name>Gazebo/Wood</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>3 1 1</size></box></geometry></collision>
      </link>
    </model>


    <model name='entrance_gate_left'>
      <static>true</static>
      <pose>-2 -4 1.25 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>0.5 0.5 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name='entrance_gate_right'>
      <static>true</static>
      <pose>2 -4 1.25 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>0.5 0.5 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name='entrance_gate_top'>
      <static>true</static>
      <pose>0 -4 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>4.5 0.5 0.5</size></box></geometry> <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>4.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>


    <model name='exit_gate_left'>
      <static>true</static>
      <pose>-2 4 1.25 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>0.5 0.5 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name='exit_gate_right'>
      <static>true</static>
      <pose>2 4 1.25 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>0.5 0.5 2.5</size></box></geometry>
        <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>0.5 0.5 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name='exit_gate_top'>
      <static>true</static>
      <pose>0 4 2.5 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><box><size>4.5 0.5 0.5</size></box></geometry>
        <material><script><name>Gazebo/Bricks</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
        <collision name='c'><geometry><box><size>4.5 0.5 0.5</size></box></geometry></collision>
      </link>
    </model>


    <model name='start_mark'>
      <static>true</static>
      <pose>0 -7 0.1 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry>
        <material><script><name>Gazebo/Green</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>
    </model>

    <model name='goal_mark'>
      <static>true</static>
      <pose>0 7 0.1 0 0 0</pose>
      <link name='link'>
        <visual name='v'><geometry><cylinder><radius>0.5</radius><length>0.1</length></cylinder></geometry>
        <material><script><name>Gazebo/Red</name><uri>file://media/materials/scripts/gazebo.material</uri></script></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>