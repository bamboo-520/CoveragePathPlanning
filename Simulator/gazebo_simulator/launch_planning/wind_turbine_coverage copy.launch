<launch>
    <!-- ==================== Gazebo 仿真 ==================== -->
    <arg name="x" default="0.0"/>
    <arg name="y" default="-5.0"/>
    <arg name="z" default="0.0"/>
    <arg name="world" default="$(find prometheus_gazebo)/worlds/wind_turbine_gazebo.world"/>
    <arg name="sdf"   default="$(find prometheus_gazebo)/amov_models/p450_3Dlidar/p450_3Dlidar.sdf"/>
    <arg name="model" default="p450_3Dlidar"/>
    <include file="$(find prometheus_gazebo)/launch_basic/sitl.launch">
        <arg name="world" value="$(arg world)"/>
        <arg name="sdf"   value="$(arg sdf)"/>
        <arg name="model" value="$(arg model)"/>
        <arg name="x"     value="$(arg x)"/>
        <arg name="y"     value="$(arg y)"/>
        <arg name="z"     value="$(arg z)"/>
    </include>

    <!-- ==================== 风机模型点云发布 ==================== -->
    <!-- 直接发布到 /prometheus/global_planning/global_pcl -->
    <node pkg="prometheus_global_planning" type="wind_turbine_model_pcl_pub" name="wind_turbine_model_pcl_pub" output="screen">
        <param name="model/frame_id" value="world"/>
        <!-- 发布频率 -->
        <param name="model/publish_rate" value="1.0" type="double"/>
        <!-- 风机底座中心（world系） -->
        <param name="model/base_x" value="0.0" type="double"/>
        <param name="model/base_y" value="0.0" type="double"/>
        <param name="model/base_z" value="0.0" type="double"/>
        <!-- 塔筒 -->
        <param name="model/tower_radius" value="0.35" type="double"/>
        <param name="model/tower_height" value="13.6" type="double"/>
        <!-- 机舱 -->
        <param name="model/nacelle_length" value="2.0" type="double"/>
        <param name="model/nacelle_width"  value="1.0" type="double"/>
        <param name="model/nacelle_height" value="1.0" type="double"/>
        <!-- 轮毂中心相对塔底 -->
        <param name="model/hub_x_offset" value="0.0" type="double"/>
        <param name="model/hub_y_offset" value="0.0" type="double"/>
        <param name="model/hub_z_offset" value="13.2" type="double"/>
        <!-- 叶片近似参数 -->
        <param name="model/blade_length" value="6.5" type="double"/>
        <param name="model/blade_width"  value="0.35" type="double"/>
        <param name="model/blade_thick"  value="0.12" type="double"/>
        <param name="model/blade_root_offset" value="0.8" type="double"/>
        <!-- 点云采样间隔 -->
        <param name="model/sample_step" value="0.15" type="double"/>
    </node>
    <!-- ==================== 全局规划算法 ==================== -->
    <node pkg="prometheus_global_planning" name="global_planner_main" type="global_planner_main" output="screen" launch-prefix="gnome-terminal --">
        <!-- 参数 -->
        <param name="global_planner/is_2D" value="false" type="bool"/>
        <param name="global_planner/fly_height_2D" value="1.0" type="double"/>
        <param name="global_planner/safe_distance" value="0.01" type="double"/>
        <param name="global_planner/time_per_path" value="1.0" type="double"/>
        <param name="global_planner/replan_time" value="0.2" type="double"/>
        <param name="global_planner/map_input" value="0" type="int"/>
        <param name="global_planner/sim_mode" value="true" type="bool"/>
        <param name="global_planner/algorithm_mode" value="0" type="int"/>
        <!-- A* -->
        <param name="astar/allocate_num" value="100000" type="int"/>
        <param name="astar/lambda_heu" value="2.0" type="double"/>
        <!-- 地图 -->
        <param name="map/resolution" value="0.15" type="double"/>
        <param name="map/inflate" value="0.5" type="double"/>
        <!-- 这里一定要比风机大很多 -->
        <param name="map/origin_x" value="-15.0" type="double"/>
        <param name="map/origin_y" value="-15.0" type="double"/>
        <param name="map/origin_z" value="-0.5" type="double"/>
        <param name="map/map_size_x" value="30.0" type="double"/>
        <param name="map/map_size_y" value="30.0" type="double"/>
        <param name="map/map_size_z" value="25.0" type="double"/>
    </node>
    <!-- ==================== 风机覆盖航点生成 ==================== -->
    <!-- 这个节点会往 /prometheus/planning/goal 发点 -->
    <node pkg="prometheus_global_planning" type="wind_turbine_coverage_planner" name="wind_turbine_coverage_planner" output="screen" launch-prefix="gnome-terminal --">
        <param name="coverage/frame_id" value="world"/>
        <!-- 风机底座中心 -->
        <param name="coverage/base_x" value="0.0" type="double"/>
        <param name="coverage/base_y" value="0.0" type="double"/>
        <param name="coverage/base_z" value="0.0" type="double"/>
        <!-- 塔筒几何 -->
        <param name="coverage/tower_radius" value="0.35" type="double"/>
        <param name="coverage/tower_height" value="13.6" type="double"/>
        <!-- 螺旋扫描参数 -->
        <param name="coverage/offset_distance" value="2.0" type="double"/>
        <param name="coverage/spiral_pitch" value="3.0" type="double"/>
        <param name="coverage/wp_arc_step" value="0.4" type="double"/>
        <!-- 扫描高度范围 -->
        <param name="coverage/z_start" value="1.5" type="double"/>
        <param name="coverage/z_end" value="12.0" type="double"/>
        <!-- 到点判定 -->
        <param name="coverage/reach_dist" value="0.4" type="double"/>
        <param name="coverage/publish_interval" value="1.0" type="double"/>
    </node>
    <!-- ==================== RViz ==================== -->
    <arg name="visualization" default="true"/>
    <group if="$(arg visualization)">
        <node type="rviz" name="rviz" pkg="rviz" args="-d $(find prometheus_gazebo)/config/rviz_config/rviz_config_astar.rviz" />
    </group>
</launch>